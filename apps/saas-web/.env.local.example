# Copy to .env.local — run `npx convex dev` in packages/convex first
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Express pipeline (script, render, scrape) — proxied via next.config rewrites when empty
NEXT_PUBLIC_API_URL=http://127.0.0.1:3847

# Convex Auth (set in Convex dashboard / convex env)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
