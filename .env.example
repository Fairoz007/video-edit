# Copy to .env and fill in keys.
# SaaS frontend: apps/saas-web/.env.local.example → .env.local
# Convex backend: packages/convex/.env.local + R2/Auth in Convex dashboard

# --- Media APIs ---
# Pexels https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay https://pixabay.com/api/docs/
PIXABAY_API_KEY=

BACKEND_PORT=3847

# --- Script LLM (gemini | groq | auto) ---
SCRIPT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- TTS (elevenlabs | chatterbox | auto) ---
TTS_PROVIDER=auto
TTS_VOICE=
TTS_RATE=175
TTS_PITCH=0
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_IDS=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_FALLBACK_CHATTERBOX=1

# Chatterbox (local). macOS: CHATTERBOX_DEVICE=mps  Windows+CUDA: CHATTERBOX_DEVICE=cuda
CHATTERBOX_PYTHON=python3
CHATTERBOX_DEVICE=
CHATTERBOX_SETUP_MODELS=turbo
CHATTERBOX_ONESHOT=0
CHATTERBOX_MAX_CHARS=480
CHATTERBOX_WORKER_TIMEOUT_MS=600000
CHATTERBOX_START_TIMEOUT_MS=180000
VOICE_PREVIEW_WARM=0

NARRATION_WPM=150
MIN_IMAGE_WIDTH=1920
CHANNEL_NAME=DocuForge
WALKTHROUGH_SEC_PER_SCREEN=4

DEFAULT_RESOLUTION=1080p
FFMPEG_PATH=

# MUSIC_BG_VOLUME=0.12
# MUSIC_BG_DISABLED=1
